[Unit]
Description=Daily Prophet Wi-Fi bootstrap (AP vs home STA)
Documentation=file:/usr/local/lib/dailyprophet/network/bootstrap.sh
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target
# If your Wi-Fi interface is not wlan0, set WLAN_IF in /etc/default/dailyprophet-network
# and optionally add After=sys-subsystem-net-devices-<iface>.device via a drop-in.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/dailyprophet/network/bootstrap.sh boot

[Install]
WantedBy=network-pre.target
