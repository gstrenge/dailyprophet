[Unit]
Description=Daily Prophet Wi-Fi bootstrap (AP vs home STA)
Documentation=file:/usr/local/lib/dailyprophet/network/bootstrap.sh
After=NetworkManager.service
Wants=NetworkManager.service
# Runs before network.target so AP is up when multi-user services start
Before=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/dailyprophet/network/bootstrap.sh boot
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
